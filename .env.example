# ===== 应用 =====
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== 数据库（当前环境：虚拟机 PostgreSQL 16）=====
# 连接串格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# 注意：下面口令仅用于本地开发示例，生产/共享环境必须通过环境变量注入真实口令。
DATABASE_URL=postgresql+psycopg://crs:crs_dev_password@192.168.200.188:5432/contract_review
DB_POOL_SIZE=5
DB_ECHO=false

# ===== 附件与解析 =====
ATTACHMENT_ROOT=data/attachments
MAX_FILE_MB=50
MAX_PAGES=200
PARSE_TIMEOUT_SECONDS=120
OCR_ENGINE=rapidocr

# ===== 审批系统（M1 起使用）=====
APPROVAL_SYSTEM_BASE_URL=http://127.0.0.1:8100
APPROVAL_SYSTEM_TIMEOUT_SECONDS=10
MOCK_HOST=127.0.0.1
MOCK_PORT=8100

# ===== 任务编排 =====
PIPELINE_CONCURRENCY=5
MAX_RETRY=5
STALE_TASK_SECONDS=600
WRITEBACK_BLOCKING=true
COMMENT_MAX_CHARS=5000

# ===== LLM（可选增强，默认关闭；OpenAI 兼容接口）=====
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
# 可选：网关要求的会话标识（如 OpenCode Go 的 x-opencode-session；留空则自动生成）
LLM_SESSION_ID=
LLM_USER_AGENT=contract-review-system/0.1.0

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=logs

# Windows 中文安全（也可在终端设置）
PYTHONUTF8=1
